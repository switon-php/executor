{
    "name": "switon/executor",
    "description": "Runner execution with batch, any-first, and task-scoped concurrency APIs for Switon Framework",
    "type": "library",
    "keywords": [
        "switon",
        "executor",
        "tasks",
        "runtime"
    ],
    "homepage": "https://github.com/switon-php/executor",
    "license": "MIT",
    "authors": [
        {
            "name": "switon",
            "email": "admin@switon.dev"
        }
    ],
    "support": {
        "source": "https://github.com/switon-php/executor",
        "issues": "https://github.com/switon-php/executor/issues",
        "docs": "https://docs.switon.dev/latest/executor"
    },
    "require": {
        "php": ">=8.3",
        "switon/core": "^1.0",
        "switon/event": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "switon/testing": "^1.0",
        "phpstan/extension-installer": "^1.4"
    },
    "suggest": {
        "ext-swoole": "Coroutine paths; local/CI with ext runs full suite; without ext PHPUnit skips those classes (see CI matrix)."
    },
    "config": {
        "allow-plugins": {
            "switon/composer-extra": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Switon\\Executor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Switon\\Executor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyse",
        "test": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=all --display-deprecations --display-phpunit-notices"
    },
    "extra": {
        "branch-alias": {
            "dev-dev": "1.0.x-dev"
        }
    }
}
